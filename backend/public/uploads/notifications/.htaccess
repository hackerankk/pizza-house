Options -Indexes -ExecCGI
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .jpg .jpeg .png .webp .mp3 .wav .ogg

<FilesMatch "(?i)(^\.|\.(php[0-9]*|phtml|phar|cgi|pl|asp|aspx|jsp|sh|bat|cmd|exe)(\.|$))">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>
