APP_ENV=local
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pizza_house
DB_USER=root
DB_PASS=

JWT_SECRET=change-me-to-a-long-random-secret

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

GOOGLE_MAPS_BROWSER_API_KEY=

# Actual sender authorized by the hosting account; requires working PHP mail().
# SMTP_FROM_EMAIL is a legacy fallback sender, not an SMTP connection setting.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="The Pizza House"

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP_NUMBER=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Request security. Apply migrations/2026_10_20_request_security.sql before deployment.
# Generate a random value with at least 32 characters; keep it server-only.
RATE_LIMIT_SECRET=
RATE_LIMIT_NAMESPACE=pizza-house
RATE_LIMIT_PUBLIC_REQUESTS=120
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
RATE_LIMIT_USER_REQUESTS=600
RATE_LIMIT_USER_WINDOW_SECONDS=60
RATE_LIMIT_EDGE_IP_REQUESTS=1800
RATE_LIMIT_EDGE_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_IP_REQUESTS=30
RATE_LIMIT_AUTH_ACCOUNT_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_ACCOUNT_FAILURES=3
RATE_LIMIT_AUTH_IP_FAILURES=10
RATE_LIMIT_AUTH_BACKOFF_BASE_SECONDS=2
RATE_LIMIT_AUTH_BACKOFF_MAX_SECONDS=300
RATE_LIMIT_AUTH_FAILURE_DECAY_SECONDS=900
RATE_LIMIT_RETENTION_SECONDS=86400
RATE_LIMIT_CLEANUP_EVERY_REQUESTS=100
RATE_LIMIT_CLEANUP_ROWS=500
# Exact IPs of trusted reverse proxies only; leave empty for direct hosting.
RATE_LIMIT_TRUSTED_PROXIES=
REQUEST_MAX_BYTES=262144
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_IMAGE_PIXELS=16000000
# Optional absolute path outside the web root; default is backend/storage.
UPLOAD_STORAGE_PATH=
