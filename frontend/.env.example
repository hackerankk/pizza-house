NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
ADMIN_FRONTEND_PATH=secure-dashboard
# Public HTTPS origin, without a path. Leave blank locally; never use a preview URL.
NEXT_PUBLIC_SITE_URL=
# production enables indexing only with a valid public SITE_URL; staging blocks indexing.
NEXT_PUBLIC_SITE_ENV=staging
# Optional GA4 measurement ID. Analytics remains off until explicit consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set true only after disabling GA4 Enhanced Measurement and automatic event detection.
NEXT_PUBLIC_GA_AUTOMATIC_COLLECTION_DISABLED=false
# Optional comma-separated HTTPS origins for image optimization.
NEXT_PUBLIC_IMAGE_ORIGINS=
# Additional allowed media origins for report-only CSP.
SECURITY_CSP_IMAGE_ORIGINS=
SECURITY_CSP_MEDIA_ORIGINS=
